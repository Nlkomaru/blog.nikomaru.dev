{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"root": true,
	"files": {
		"includes": [
			"app/**",
			"*.ts",
			"*.json",
			"!node_modules",
			"!dist",
			"!.cloudflare",
			"!app/routeTree.gen.ts"
		]
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	}
}
